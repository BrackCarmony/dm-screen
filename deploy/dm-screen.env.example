PORT=3000
SESSION_SECRET=a-long-random-string
DATA_DIR=/var/lib/dm-screen
APP_URL=https://dm-screen.brackcarmony.com
# Extra admins besides the first account, comma separated.
# ADMIN_EMAILS=

# Email for password resets: Mailgun or SMTP. Without either, reset links go to the server log.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.brackcarmony.com
# MAILGUN_BASE_URL=https://api.eu.mailgun.net
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=DM Screen <no-reply@mg.brackcarmony.com>

# AI monster generation in the Bestiary (beta). Without a key the feature is hidden.
ANTHROPIC_API_KEY=
# Generations each account gets (default 5).
# AI_BETA_USES=5

# Sign in with Google (OAuth client, type Web application). Redirect URI: $APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
